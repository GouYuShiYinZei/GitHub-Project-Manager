[Unit]
Description=GitHub Star Manager web app
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/github-star-manager
Environment=NODE_ENV=production
Environment=VITE_BASE=/github-manager/
ExecStart=/usr/bin/npm run preview -- --host 127.0.0.1 --port 4173
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
